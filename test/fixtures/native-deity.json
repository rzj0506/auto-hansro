  "banishChestCard": "function banishChestCard(e,t){return this.perksLeft.banish<=0?null:(this.perksLeft.banish--,this.banishedItems.add(e.item),this.focusedItems.delete(e.item),this.runItems.roll(this.deityLearned(),this.chestOpts(),1,t.map(n=>n.slot))[0]??this.runItems.rollSlot(e.slot,this.deityLearned(),this.chestOpts()))}"
